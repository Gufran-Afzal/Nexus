# Copy to .env (same folder) to override defaults. All values are optional.
# NEXUS never reads secrets from here; there are no API keys because nothing uses the cloud.

# Where the database, logs, backups and speech models live (default: %LOCALAPPDATA%\NEXUS)
# NEXUS_DATA_DIR=D:\NEXUS-data

# Local server address. Keep the host on 127.0.0.1.
# NEXUS_PORT=8765

# Ollama endpoint and the model used on first run (can be changed in the UI)
# NEXUS_OLLAMA_URL=http://localhost:11434
# NEXUS_DEFAULT_MODEL=qwen2.5-coder:7b

# Limits
# NEXUS_MAX_CONCURRENT_INFERENCE=1
# NEXUS_COMMAND_TIMEOUT_S=300
# NEXUS_COMMAND_OUTPUT_LIMIT=200000
# NEXUS_MAX_FILE_BYTES=1000000
